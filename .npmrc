shamefully-hoist=true
# VS 2026 is reported as version 18 by Visual Studio Installer.
msvs_version=2026
# pnpm 10 bundles a node-gyp version that does not recognize VS 2026.
# Use the project dependency instead; this path is relative to pnpm's package
# working directory under node_modules/.pnpm.
node_gyp=../../../../../node_modules/node-gyp/bin/node-gyp.js
clang=0
# Forces electron/rebuild to use gcc/g++ instead of clang on Linux and msvc on Windows
