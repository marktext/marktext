{
  "name": "marktext-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/build-docs-index.ts --if-missing && next dev --port 3000",
    "docs:index": "tsx scripts/build-docs-index.ts",
    "project-info:update": "tsx scripts/update-project-info.ts",
    "prebuild": "pnpm run project-info:update && tsx scripts/build-docs-index.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test:project-info": "tsx --tsconfig scripts/tsconfig.test.json --test scripts/project-info.test.tsx",
    "test:downloads": "tsx --tsconfig scripts/tsconfig.test.json --test scripts/downloads.test.tsx",
    "test:markdown": "tsx --test scripts/markdown.test.ts",
    "cf:build": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && opennextjs-cloudflare populateCache local",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:smoke": "node scripts/smoke-worker.mjs",
    "cf:deploy": "opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "flowchart.js": "^1.18.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "hast-util-to-string": "^3.0.1",
    "mermaid": "^12.1.0",
    "next": "15.5.27",
    "plantuml-encoder": "^1.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gemoji": "^8.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.5.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vega-lite": "^6.5.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.9",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "wrangler": "^4.148.0"
  }
}
