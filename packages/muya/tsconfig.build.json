{
    // Declaration-only build, for consumers that need the typings without the
    // bundle (see the desktop package's `typecheck` script). `pnpm build`
    // emits into the same directory through vite-plugin-dts.
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "emitDeclarationOnly": true,
        "declaration": true,
        // Keep the cache inside `lib/`, which `vite build` empties: a build
        // that wipes the declarations wipes the cache that claims they exist.
        "incremental": true,
        "tsBuildInfoFile": "lib/types/.tsbuildinfo"
    },
    // The specs are type-checked by `lint:types`; emitting declarations for
    // them only pads the output (and `files: ["lib"]` would publish them).
    "exclude": ["src/**/__tests__/**"]
}
