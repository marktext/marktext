    "electron-window-state": "^5.0.3",
    "element-plus": "^2.14.7",
    "flowchart.js": "^1.18.0",
    "font-list": "^2.1.0",
    "fs-extra": "^11.4.1",
    "fuzzaldrin": "^2.1.0",
    "github-markdown-css": "^5.9.0",
    "iso-639-1": "^3.1.6",
    "katex": "^0.19.0",
    "keytar": "^7.9.0",
    "lodash": "^4.18.1",
    "mermaid": "^12.1.0",
    "minimatch": "^10.2.6",
    "mitt": "^3.0.1",
    "ms": "^2.1.3",
    "pako": "^3.0.2",
    "pathe": "^2.0.3",
    "pinia": "^4.0.3",
    "plist": "^5.0.0",
    "prismjs": "^1.30.0",
    "snabbdom": "^3.6.4",
    "snabbdom-to-html": "^7.1.0",
    "snapsvg-cjs": "^0.0.6",
    "underscore": "^1.13.8",
