    "@hfelix/electron-localshortcut": "^4.0.1",
    "@intlify/core-base": "^11.4.13",
    "@marktext/file-icons": "^1.0.6",
    "@muyajs/core": "workspace:*",
    "@vscode/ripgrep": "^1.18.0",
    "arg": "^5.0.2",
    "axios": "^1.20.0",
    "ced": "^2.0.0",
    "chokidar": "^5.0.0",
