    "postcss-preset-env": "^11.6.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-svg-loader": "^5.1.3",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-tsc": "3.3.11"
  }
}
